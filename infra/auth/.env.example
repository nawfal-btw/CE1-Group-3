# Copy to .env, then supply independent randomly generated credentials.
# Empty passwords intentionally prevent Compose from starting.
# Do not commit .env or share output from `docker compose config`.
AUTH_DB_PASSWORD=
AUTH_ADMIN_USERNAME=local-admin
AUTH_ADMIN_PASSWORD=

# Required on a fresh database; give the eventual BFF this same secret.
# Existing realms ignore import changes: this does NOT rotate their secret.
AUTH_BFF_CLIENT_SECRET=
AUTH_BFF_REDIRECT_URI=http://localhost:8082/auth/callback
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_SSL_REQUIRED=none
AUTH_KEYCLOAK_URL=http://localhost:8081
AUTH_HTTP_PORT=8081
